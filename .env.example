APP_NAME=PaySomeoneToWrite
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:18473

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Point this at a COPY of the live database while you test.
# On the server, use the real database name and user cPanel gives you.
# Do not put the live password in this file. Put it only in .env on the server.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=paysomeone_local
DB_USERNAME=
DB_PASSWORD=

# File sessions and file cache work on ordinary shared hosting.
# Switch to database only after the app_ tables have been migrated.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_TABLE=app_sessions

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
DB_QUEUE_TABLE=app_jobs

CACHE_STORE=file
DB_CACHE_TABLE=app_cache

# Keep both of these true on any server that uses the live database
# until you are ready for this site to change orders and send mail.
READ_ONLY_LEGACY=true
SAFE_MODE=true

# Which site row in prox_site this install belongs to.
LEGACY_SITE_ID=1
LEGACY_ADMIN_SITE_ID=1

# The seeder refuses to run if the database name matches this.
LEGACY_LIVE_DATABASE=tutoress_paysomeone
# Never set this true on the live database.
LEGACY_ALLOW_SEED=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="studio@paysomeonetowrite.com"
MAIL_FROM_NAME="${APP_NAME}"

# Shared uploads folder, outside the web root. On the server, point this at
# the same folder the current site stores order files in.
LEGACY_UPLOADS_PATH=

# Sandbox credentials. Leave them empty until SAFE_MODE is turned off.
# Nothing is sent to these providers while SAFE_MODE=true.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=
MPESA_INITIATOR=
MPESA_SECURITY_CREDENTIAL=
MPESA_B2C_MOCK=false

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Local webhook check. PayPal's own signature check is used when you add it later.
PAYPAL_WEBHOOK_SECRET=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=

VITE_APP_NAME="${APP_NAME}"
