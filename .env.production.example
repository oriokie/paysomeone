# Copy this file to .env on the server. Fill in the blanks.
# Do not upload a .env that already has a password in it.
# SAFE_MODE and READ_ONLY_LEGACY stay true until you decide otherwise.
# Mail stays on "log" until a real provider is ready, so nothing is sent.

APP_NAME=PaySomeoneToWrite
# production, not local.
APP_ENV=production
# Leave this empty. The installer or `php artisan key:generate` fills it once.
APP_KEY=
# Must stay false on the server. true shows errors to visitors.
APP_DEBUG=false
# https://new.paysomeonetowrite.com  with no slash at the end.
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# The live database the current site already uses.
# Use the host cPanel shows, often localhost.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# File sessions work on shared hosting before the new tables exist.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_TABLE=app_sessions

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# sync sends (or logs) mail during the page request.
# Change to database only after the app_ tables exist and the cron is installed.
QUEUE_CONNECTION=sync
DB_QUEUE_TABLE=app_jobs

CACHE_STORE=file
DB_CACHE_TABLE=app_cache

# Leave both true. true means this site will not change prox_ rows and will not
# call M-Pesa, PayPal, Stripe, Pesapal, or send real email.
READ_ONLY_LEGACY=true
SAFE_MODE=true

# Leave true so the office asks for an authenticator code.
# Set false only when a preview should open after the password.
# Staff can still open the security page and turn two-factor on.
OFFICE_2FA_REQUIRED=true

# The site_id of this brand in prox_site. Look it up in phpMyAdmin before changing it.
LEGACY_SITE_ID=1
LEGACY_ADMIN_SITE_ID=1
LEGACY_ORDER_ID_STEP=2

# The seeder refuses to run when the database name matches this.
# Leave the name as it is. Do not turn the next line on.
LEGACY_LIVE_DATABASE=tutoress_paysomeone
LEGACY_ALLOW_SEED=false

# A folder outside the website, shared with the current site if you know its path.
# Example: /home/USERNAME/private/order-uploads
LEGACY_UPLOADS_PATH=

# Invent a long random string. The installer stays off until this is set.
# It is not a password for the office. After setup, the installer turns itself off.
INSTALL_TOKEN=

# log keeps every message in storage/logs and does not deliver it.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
# Only if you later choose SES.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

# Leave the payment values empty until SAFE_MODE is turned off on purpose.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=
MPESA_INITIATOR=
MPESA_SECURITY_CREDENTIAL=
MPESA_B2C_MOCK=false

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_SECRET=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=

VITE_APP_NAME="${APP_NAME}"
